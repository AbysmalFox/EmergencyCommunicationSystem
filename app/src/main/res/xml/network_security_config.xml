<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- For production, we connect to a secure HTTPS domain.
         No special cleartext permissions are required. The default system configuration is sufficient. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext traffic (HTTP) for local fallback -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.7</domain> <!-- Update this! -->
        <domain includeSubdomains="true">emergency-comm.alertaraqc.com</domain>
    </domain-config>
</network-security-config>
